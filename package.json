{
  "name": "@fraziym/promochu",
  "version": "0.3.0-beta.1",
  "description": "Promochu \u2014 professional Gmail farm + cold email outreach platform. Account health tracking, warmup automation, multi-step sequences, AI personalization, analytics, and FRAZIYM security integration.",
  "type": "module",
  "license": "MIT",
  "author": "AKIK FARAJI <akikfaraji@gmail.com> (https://fraziym.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akik-Forazi/promochu.git"
  },
  "homepage": "https://github.com/Akik-Forazi/promochu#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "promochu": "./src/index.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "farm": "node src/index.js --farm",
    "campaign": "node src/index.js --campaign",
    "leads:import": "node src/index.js --import-leads",
    "stats": "node src/index.js --stats",
    "warmup": "node src/index.js --warmup",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "nodemailer": "^6.9.13",
    "better-sqlite3": "^11.0.0"
  },
  "optionalDependencies": {
    "@fraziym/xorvoid": ">=0.1.0-beta.1",
    "@fraziym/xorgis": ">=0.1.0-beta.1",
    "@fraziym/axoniz": ">=0.1.8-beta.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.6.4"
  }
}

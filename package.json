{
  "name": "@fraziym/promochu",
  "version": "0.2.0-beta.1",
  "description": "Promochu \u2014 AI-powered cold email automation with sender rotation, analytics tracking, and FRAZIYM ecosystem integration (xorvoid error tracking + xorgis secret protection).",
  "type": "module",
  "license": "MIT",
  "author": "AKIK FARAJI <akikfaraji@gmail.com> (https://fraziym.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akik-Forazi/promochu.git"
  },
  "homepage": "https://github.com/Akik-Forazi/promochu#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "promochu": "./src/index.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "campaign": "node src/index.js --campaign",
    "leads:import": "node src/index.js --import-leads",
    "stats": "node src/index.js --stats",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "nodemailer": "^6.9.13"
  },
  "optionalDependencies": {
    "@fraziym/xorvoid": ">=0.1.0-beta.1",
    "@fraziym/xorgis": ">=0.1.0-beta.1",
    "@fraziym/axoniz": ">=0.1.8-beta.1"
  },
  "optionalDependenciesMeta": {},
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}

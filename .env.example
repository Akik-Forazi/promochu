# Promochu Configuration
# Copy to .env and fill in your values

# Comma-separated list of Gmail accounts with App Passwords
# Format: email:16charapppassword,email2:16charapppassword
SENDER_ACCOUNTS="sender1@gmail.com:abcd1234efgh5678,sender2@gmail.com:ijkl9012mnop3456"

# Path to leads JSON file
LEADS_FILE="./leads.json"

# Path to database JSON file (auto-created)
DATABASE_FILE="./database.json"

# Emails per hour per account (default: 30)
RATE_PER_HOUR_PER_ACCOUNT=30

# Sender name
FROM_NAME="Promochu Team"

# Email subject template (supports {{firstName}}, {{lastName}}, {{email}}, {{company}})
SUBJECT_TEMPLATE="Special offer for {{firstName}}"

# HTML email template path
HTML_TEMPLATE_FILE="./templates/email.html"

# Text email template path
TEXT_TEMPLATE_FILE="./templates/email.txt"
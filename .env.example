# @fraziym/promochu Configuration
# Copy to .env and fill in your values

# ── Gmail Farm ──────────────────────────────────
# Comma-separated Gmail accounts with App Passwords
# Format: email:apppassword,email2:apppassword2
SENDER_ACCOUNTS="sender1@gmail.com:abcd1234efgh5678,sender2@gmail.com:ijkl9012mnop3456"

# Farm database (SQLite) — stores account health, leads, campaigns, sends
FARM_DATABASE="./.promochu/farm.db"

# ── Rate Limiting ───────────────────────────────
# Emails per hour per account (hard cap, cannot be overridden)
RATE_PER_HOUR_PER_ACCOUNT=30

# Enable warmup for new accounts (gradual volume increase)
WARMUP_ENABLED=true

# Warmup schedule (days:emails_per_day)
WARMUP_SCHEDULE="3:5,4:10,4:20,3:30"

# ── Campaign ────────────────────────────────────
# Path to leads JSON file
LEADS_FILE="./leads.json"

# Sender name
FROM_NAME="Your Name"

# Subject template (supports {{firstName}}, {{lastName}}, {{company}}, {{email}})
SUBJECT_TEMPLATE="Hi {{firstName}}, quick question"

# HTML email template path
HTML_TEMPLATE_FILE="./templates/email.html"

# Text email template path
TEXT_TEMPLATE_FILE="./templates/email.txt"

# ── Multi-step Sequences ────────────────────────
# Enable sequence mode (sends multiple emails over time)
SEQUENCE_ENABLED=false

# Sequence schedule (day:template_file)
# Day 1: intro, Day 3: follow-up, Day 7: social proof, Day 12: breakup
SEQUENCE_STEPS="1:templates/step1-intro.html,3:templates/step2-followup.html,7:templates/step3-social.html,12:templates/step4-breakup.html"

# Stop sequence on reply
STOP_ON_REPLY=true

# ── Analytics ───────────────────────────────────
# Open tracking (embedding pixel in HTML emails)
OPEN_TRACKING=true

# Click tracking (redirect links through tracker)
CLICK_TRACKING=true

# Reply detection (monitor inbox via IMAP)
REPLY_DETECTION=false

# IMAP credentials for reply detection
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""

# ── Security (@fraziym/xorgis, optional) ──────
# Encrypt app passwords at rest (post-quantum crypto)
CREDENTIAL_VAULT_ENABLED=true

# Scan email content for leaked secrets/API keys before sending
CONTENT_SCAN_ENABLED=true

# Tamper-proof audit log of every email sent
AUDIT_LOG_ENABLED=true

# CAN-SPAM compliance (auto-unsubscribe link, physical address)
CANSPAM_COMPLIANCE=true

# Physical address (required by CAN-SPAM if compliance enabled)
PHYSICAL_ADDRESS="123 Main St, City, State 12345"

# ── AI Personalization (@fraziym/axoniz, optional) ─
# Generate unique email body per lead using AI
AI_PERSONALIZATION=false

# AI model to use for personalization
AI_MODEL="local"

# ── Error Tracking (@fraziym/xorvoid, optional) ─
# Capture send failures and auto-retry
ERROR_TRACKING=true
